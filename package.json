{
  "name": "moviefinder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vault run -- bun scripts/dev.ts",
    "dev:local": "bun scripts/dev.ts",
    "start": "bun src/server/index.ts",
    "build": "vp build",
    "check": "vp check && vp test run --project unit",
    "test": "vp test run --project unit",
    "test:integration": "bun scripts/verify.ts integration",
    "test:e2e": "bun scripts/verify.ts e2e",
    "format": "vp fmt",
    "lint": "vp lint",
    "db:validate": "atlas migrate validate --dir file://atlas/migrations",
    "db:check": "vault run -- bun scripts/database-check.ts",
    "db:diff": "bun scripts/migrate.ts diff",
    "db:migrate": "vault run -- bun scripts/migrate.ts apply",
    "db:status": "vault run -- bun scripts/migrate.ts status",
    "db:drift": "vault run -- bun scripts/migrate.ts drift",
    "db:verify": "bun scripts/schema-diff.ts verify --check"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@tanstack/query-db-collection": "1.4.5",
    "@tanstack/react-db": "0.5.10",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-router": "1.170.44",
    "better-auth": "1.7.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "fractional-indexing": "4.0.0",
    "hono": "4.13.13",
    "lucide-react": "1.57.0",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swiper": "14.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fast-check": "4.10.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite-plus": "1.2.0"
  },
  "packageManager": "bun@1.4.2"
}
